{
  "name": "three-hex-map",
  "version": "0.5.0",
  "description": "A browser-first 3D hex-world renderer and streamed-world runtime built on three.js.",
  "type": "module",
  "main": "dist/hex-map.cjs",
  "module": "dist/hex-map.mjs",
  "types": "dist/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/types/index.d.ts",
      "import": "./dist/hex-map.mjs",
      "require": "./dist/hex-map.cjs"
    },
    "./persistence": {
      "types": "./dist/types/persistence.d.ts",
      "import": "./dist/persistence.mjs",
      "require": "./dist/persistence.cjs"
    },
    "./pathfinding": {
      "types": "./dist/types/pathfinding.d.ts",
      "import": "./dist/pathfinding.mjs",
      "require": "./dist/pathfinding.cjs"
    },
    "./simulation": {
      "types": "./dist/types/simulation.d.ts",
      "import": "./dist/simulation.mjs",
      "require": "./dist/simulation.cjs"
    },
    "./world-generator.worker": "./dist/world-generator.worker.mjs"
  },
  "unpkg": "dist/hex-map.global.js",
  "files": [
    "dist"
  ],
  "scripts": {
    "build:lib": "tsup && tsc -p tsconfig.build.json && rollup -c rollup.config.global.mjs",
    "build:demo": "npm run build:lib && node scripts/copy-demo-assets.cjs",
    "build": "npm run build:demo",
    "server": "http-server public -c-1 -p 3000",
    "start": "npm run build && npm run server",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "test:stability": "vitest run tests/stability",
    "test:soak": "playwright test tests/e2e/foundation-soak.spec.ts",
    "review:world-style": "node scripts/review-world-style.mjs",
    "review:world-style:metrics": "vitest run --config vitest.world-style.config.ts",
    "review:world-style:gallery": "playwright test --config playwright.gallery.config.ts",
    "test:watch": "vitest",
    "benchmark": "npm run build:lib && node --expose-gc scripts/benchmark-hot-paths.mjs",
    "benchmark:render-backends": "node scripts/benchmark-render-backends.mjs",
    "benchmark:check": "npm run build:lib && node --expose-gc scripts/benchmark-hot-paths.mjs --check",
    "check:generated": "npm run build && git diff --exit-code -- public/js"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lanyik/lanyik.git"
  },
  "keywords": [
    "civilization",
    "hex map",
    "game map",
    "threejs",
    "webgl"
  ],
  "author": "Oleg Gunyakov",
  "license": "MPL-2.0",
  "bugs": {
    "url": "https://github.com/lanyik/lanyik/issues"
  },
  "homepage": "https://github.com/lanyik/lanyik#readme",
  "engines": {
    "node": ">=20"
  },
  "peerDependencies": {
    "three": "^0.185.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@rollup/plugin-commonjs": "^29.0.3",
    "@rollup/plugin-node-resolve": "^16.0.3",
    "@types/three": "^0.185.0",
    "dat.gui": "^0.7.9",
    "fake-indexeddb": "^6.2.5",
    "http-server": "^14.1.1",
    "rollup": "^4.62.2",
    "three": "^0.185.1",
    "tsup": "^8.5.1",
    "typescript": "^6.0.3",
    "vitest": "^4.1.11"
  },
  "dependencies": {
    "robust-point-in-polygon": "^1.0.3"
  },
  "overrides": {
    "esbuild": "^0.28.2"
  }
}
