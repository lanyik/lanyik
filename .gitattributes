* text=auto eol=lf
*.bat text eol=crlf
*.png -text
*.jpg -text
*.glb -text
# Preserve the original licenses byte-for-byte, including publisher whitespace.
apps/survivor/assets/actors/*-LICENSE.txt -text -whitespace
apps/survivor/assets/effects/*-LICENSE.txt -text -whitespace
apps/survivor/assets/loot/License.txt -text -whitespace
# The loot source manifest hashes the publisher's original OBJ bytes as well.
apps/survivor/assets/loot/*.obj -text -whitespace
# Homestead source hashes and publisher attribution must survive every checkout unchanged.
apps/survivor/assets/homestead/*.obj -text -whitespace
apps/survivor/assets/homestead/*.mtl -text -whitespace
apps/survivor/assets/homestead/License.txt -text -whitespace
# Environment manifests preserve publisher license and preset bytes.
apps/survivor/assets/environment/*-LICENSE.txt -text -whitespace
apps/survivor/assets/environment/*_medium.json -text -whitespace
apps/survivor/assets/environment/texture-attribution.md -text -whitespace
scripts/vendor/*-LICENSE.txt -text -whitespace
scripts/vendor/ez-tree.mjs -whitespace linguist-vendored
apps/survivor/assets/actors/**/*.gltf -text
apps/survivor/assets/actors/**/*.bin -text

public/** linguist-vendored
webpack.config.js linguist-vendored
