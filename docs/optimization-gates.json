{
  "schemaVersion": 1,
  "decisions": [
    {
      "id": "webgpu-gpu-culling",
      "state": "deferred",
      "ownerDocument": "docs/render-backend-evaluation.md",
      "measurementScript": "benchmark:render-backends",
      "triggerMode": "any",
      "triggerGroups": [
        {
          "all": [
            { "metric": "gameplayRequiresNavigableOrEditableRiverNetwork", "operator": "==", "threshold": true }
          ]
        },
        {
          "all": [
            { "metric": "renderSubmissionOrCullingP95Ms", "operator": ">=", "threshold": 2 }
          ]
        },
        {
          "all": [
            { "metric": "sustainedDrawCalls", "operator": ">", "threshold": 500 }
          ]
        },
        {
          "all": [
            { "metric": "gpuOverdrawIsBottleneck", "operator": "==", "threshold": true },
            { "metric": "removableSubmittedInstancesPercent", "operator": ">=", "threshold": 30 }
          ]
        },
        {
          "all": [
            { "metric": "requiredWorkNeedsGpuCompute", "operator": "==", "threshold": true },
            { "metric": "existingFrameAndWorkerBudgetsExceeded", "operator": "==", "threshold": true }
          ]
        }
      ],
      "approvalRequirements": [
        "Attach a representative physical-hardware browser trace with p95 CPU and GPU timings.",
        "Record draw calls, submitted instances and measured removable-instance percentage for the same scenario.",
        "Evaluate bounded same-material/model/LOD pooling before approving a renderer migration caused only by draw-call pressure.",
        "Demonstrate terrain, water and grass visual parity plus the existing stress and leak gates on the prototype path."
      ],
      "evidenceReferences": [],
      "decisionRecord": null
    },
    {
      "id": "automatic-river-generation",
      "state": "implemented",
      "ownerDocument": "docs/world-style-generation-v1.md",
      "measurementScript": "review:world-style",
      "triggerMode": "any",
      "triggerGroups": [
        {
          "all": [
            { "metric": "explicitUserHydrologyRequirement", "operator": "==", "threshold": true }
          ]
        },
        {
          "all": [
            { "metric": "recurringHydrologyDefectSamples", "operator": ">=", "threshold": 3 },
            { "metric": "affectedTopologyGroups", "operator": ">=", "threshold": 2 },
            { "metric": "consecutiveFixedCorpusRuns", "operator": ">=", "threshold": 2 }
          ]
        }
      ],
      "approvalRequirements": [
        "Record the concrete user or gameplay requirement and why manual river content cannot satisfy procedural-world scale.",
        "Document why the existing water classification or a local parameter adjustment cannot address the defect.",
        "Specify deterministic source, confluence, mouth and cross-chunk continuity invariants before implementation.",
        "Budget generation latency, cache identity and infinite-world regional state before approving a prototype.",
        "Keep overview work proportional to output pixels and coarse courses rather than the full requested world-tile area."
      ],
      "evidenceReferences": [
        "docs/evidence/automatic-river-generation/2026-09-04.json"
      ],
      "decisionRecord": "docs/decisions/coarse-drainage-water-network.md"
    }
  ]
}
